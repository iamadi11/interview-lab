{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard (Vite)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/dashboard/src"
    },
    {
      "name": "React Playground (Vite)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/react-playground/src"
    },
    {
      "name": "Next Playground",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "--port", "3002"],
      "cwd": "${workspaceFolder}/apps/next-playground",
      "runtimeExecutable": "node",
      "serverReadyAction": {
        "pattern": "ready on",
        "uriFormat": "http://localhost:3002",
        "action": "openExternally"
      }
    },
    {
      "name": "Node Playground",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/node-playground/src/index.js",
      "cwd": "${workspaceFolder}/apps/node-playground",
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      "name": "Interview Timer (CLI)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/interview/timer.js",
      "args": ["--minutes", "60"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Interview Stack",
      "configurations": ["Dashboard (Vite)", "React Playground (Vite)"]
    }
  ]
}
